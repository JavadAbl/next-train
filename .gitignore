# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# local portable PostgreSQL (binaries + data dir) — dev-only, never commit
/.tools/

# runtime pid files
*.pid

# keep the env template tracked (while .env itself stays local)
!.env.example

# obsolete local SQLite db (app is on Postgres now) — never commit
/db/

# Neon CLI link file — machine-local (ids only, no credentials)
.neon

# sandbox agent tooling / fetched docs / scratch — never commit
/.neon-skills/
/tool-results/
/.agents/
/skills-lock.json

# user-facing download artifacts (offline git bundle etc.) — never commit
/download/*.bundle
