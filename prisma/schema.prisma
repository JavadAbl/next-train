generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")            // pooled (-pooler) for app traffic
  directUrl = env("DATABASE_URL_UNPOOLED")   // direct for migrations (Prisma requirement on Neon)
}

// role: "ADMIN" | "OPERATOR" | "REPAIRMAN" (validated by zod at API layer)
// type : "REPAIR" | "VISIT" | "REPLACEMENT"
model User {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  fullName     String
  role         String          @default("REPAIRMAN")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  records      ServiceRecord[] @relation("RepairmanRecords")
}

model Train {
  id          String          @id @default(cuid())
  name        String
  model       String?
  serialNo    String?
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  nodes       PartNode[]
  records     ServiceRecord[]
}

// One technical diagram ("print") per node. Root node: parentAreaId = null.
model PartNode {
  id           String       @id @default(cuid())
  trainId      String
  train        Train        @relation(fields: [trainId], references: [id], onDelete: Cascade)
  name         String
  image        String
  parentAreaId String?      @unique
  parentArea   Area?        @relation("ChildNode", fields: [parentAreaId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  areas        Area[]       @relation("NodeAreas")
}

// Rectangular hotspot, coords stored as percentages of the parent image.
// childNode != null -> clicking drills down; null -> serviceable part (leaf).
model Area {
  id        String          @id @default(cuid())
  nodeId    String
  node      PartNode        @relation("NodeAreas", fields: [nodeId], references: [id], onDelete: Cascade)
  name      String
  x         Float
  y         Float
  w         Float
  h         Float
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  childNode PartNode?       @relation("ChildNode")
  records   ServiceRecord[] @relation("AreaRecords")
}

model ServiceRecord {
  id          String    @id @default(cuid())
  trainId     String
  train       Train     @relation(fields: [trainId], references: [id], onDelete: Cascade)
  areaId      String?
  area        Area?     @relation("AreaRecords", fields: [areaId], references: [id], onDelete: SetNull)
  // snapshot of hierarchy names at save time, e.g. "موتور دیزل › سیلندرها › پیستون › سوپاپ چپ"
  path        String
  type        String
  date        DateTime
  description String
  partNumber  String?   // serial of the NEW part installed (REPLACEMENT) or related part no.
  removedSerial String? // serial read from the physically installed (removed) part before replacement
  serialMismatch Boolean @default(false) // removedSerial didn't match the last recorded serial
  laborHours  Float?
  repairmanId String
  repairman   User      @relation("RepairmanRecords", fields: [repairmanId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([trainId])
  @@index([areaId])
  @@index([repairmanId])
  @@index([date])
}

// Runtime-uploaded diagram images. Primary store is Neon Object Storage
// (S3-compatible bucket "assets" — the row keeps only the object key, so the row
// and the object live on the same Neon branch and never drift). When the bucket
// is unreachable from the runtime network (e.g. restricted dev environments),
// the API falls back to storing the bytes in Postgres (bytes column). Served by
// /api/uploads/[id] which streams from whichever store holds the image.
// Seed images stay as static files under public/uploads/ (committed to the repo).
model Upload {
  id        String   @id @default(cuid())
  key       String?  @unique // S3 object key in the assets bucket (null = DB-stored)
  mime      String
  bytes     Bytes?   // fallback store: image bytes kept in Postgres when S3 is unreachable
  size      Int      // byte size (for reporting)
  createdAt DateTime @default(now())
}
