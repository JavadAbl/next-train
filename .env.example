# ─── Neon (پیش‌فرض — تولید و توسعه) ─────────────────────────────────────────
# دستور `neon deploy` این متغیرها را خودکار از پروژهٔ Neon می‌کشد
# (org: org-rough-cloud-79631716 / project: rapid-math-15591303 / branch: production)
#
# DATABASE_URL        → اتصال pooled (-pooler) برای ترافیک برنامه (سرورلس/ورسل)
# DATABASE_URL_UNPOOLED → اتصال direct برای مایگریشن‌ها (directUrl در schema.prisma)
#
# Postgres:
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Object Storage (باکت assets — S3-compatible):
# AWS_ENDPOINT_URL_S3=https://br-xxx.storage.REGION.aws.neon.tech
# AWS_ACCESS_KEY_ID=nak_live_...
# AWS_SECRET_ACCESS_KEY=nsk_live_...
# AWS_REGION=eu-central-1
#
# اگر متغیرهای AWS تنظیم نباشند یا باکت در دسترس نباشد، آپلود تصاویر به‌صورت
# خودکار در خود Postgres (ستون Upload.bytes) ذخیره می‌شود — بدون از دست رفتن داده.

# ─── Postgres محلی (فقط برای توسعهٔ آفلاین) ────────────────────────────────
# DATABASE_URL=postgresql://train:train_dev_pw@127.0.0.1:5432/traindb
# DATABASE_URL_UNPOOLED=postgresql://train:train_dev_pw@127.0.0.1:5432/traindb

# ─── امنیت ────────────────────────────────────────────────────────────────
# کلید امضای کوکی‌های نشست — در محیط عملیاتی (ورسل) حتماً یک مقدار تصادفی بلند قرار دهید
# AUTH_SECRET=change-me-to-a-long-random-string
